+        private static Operand PrmtTable(EmitterContext context, Operand index, int mask, params int[] table)
+        {
+            Operand key = context.BitwiseAnd(index, Const(mask));
+            Operand result = Const(table[0]);
+
+            for (int i = 1; i < table.Length; i++)
+            {
+                result = context.ConditionalSelect(context.ICompareEqual(key, Const(i)), Const(table[i]), result);
+            }
+
+            return result;
+        }
+
+        private static void EmitPrmt(EmitterContext context, Operand srcA, Operand srcB, Operand srcC, int rd, PMode mode)
+        {
+            Operand selector = mode switch
+            {
+                PMode.F4e => PrmtTable(context, srcB, 3, 0x3210, 0x4321, 0x5432, 0x6543),
+                PMode.B4e => PrmtTable(context, srcB, 3, 0x5670, 0x6745, 0x7456, 0x4567),
+                PMode.Rc8 => PrmtTable(context, srcB, 3, 0x0000, 0x1111, 0x2222, 0x3333),
+                PMode.Ecl => PrmtTable(context, srcB, 3, 0x3210, 0x3211, 0x3222, 0x3333),
+                PMode.Ecr => PrmtTable(context, srcB, 3, 0x0000, 0x1110, 0x2210, 0x3210),
+                PMode.Rc16 => PrmtTable(context, srcB, 1, 0x1010, 0x3232),
+                _ => srcB,
+            };
+
+            Operand result = null;
+
+            if (selector.Type == OperandType.Constant)
+            {
+                // A constant selector (the usual case: the half-word packs 0x5410 and 0x7632, the copies): the bytes
+                // are picked at translation time; two-byte picks from one source with no sign become one extract.
+                int sel = selector.Value;
+
+                switch (sel)
+                {
+                    case 0x3210: context.Copy(GetDest(rd), srcA); return;
+                    case 0x7654: context.Copy(GetDest(rd), srcC); return;
+                    case 0x5410: result = context.BitwiseOr(context.BitwiseAnd(srcA, Const(0xffff)), context.ShiftLeft(srcC, Const(16))); context.Copy(GetDest(rd), result); return;
+                    case 0x7632: result = context.BitwiseOr(context.ShiftRightU32(srcA, Const(16)), context.BitwiseAnd(srcC, Const(unchecked((int)0xffff0000)))); context.Copy(GetDest(rd), result); return;
+                    case 0x1010: result = context.BitwiseOr(context.BitwiseAnd(srcA, Const(0xffff)), context.ShiftLeft(srcA, Const(16))); context.Copy(GetDest(rd), result); return;
+                    case 0x3232: result = context.BitwiseOr(context.ShiftRightU32(srcA, Const(16)), context.BitwiseAnd(srcA, Const(unchecked((int)0xffff0000)))); context.Copy(GetDest(rd), result); return;
+                }
+
+                for (int i = 0; i < 4; i++)
+                {
+                    int nibble = (sel >> (4 * i)) & 0xf;
+                    Operand src = (nibble & 4) != 0 ? srcC : srcA;
+                    Operand picked = context.BitfieldExtractU32(src, Const((nibble & 3) * 8), Const(8));
+
+                    if ((nibble & 8) != 0)
+                    {
+                        picked = context.BitwiseAnd(context.BitfieldExtractS32(src, Const((nibble & 3) * 8 + 7), Const(1)), Const(0xff));
+                    }
+
+                    Operand placed = i == 0 ? picked : context.ShiftLeft(picked, Const(8 * i));
+
+                    result = i == 0 ? placed : context.BitwiseOr(result, placed);
+                }
+
+                context.Copy(GetDest(rd), result);
+                return;
+            }
+
+            for (int i = 0; i < 4; i++)
+            {
+                Operand nibble = context.BitwiseAnd(context.ShiftRightU32(selector, Const(4 * i)), Const(0xf));
+                Operand bitOffset = context.ShiftLeft(context.BitwiseAnd(nibble, Const(3)), Const(3));
+                Operand fromA = context.BitfieldExtractU32(srcA, bitOffset, Const(8));
+                Operand fromC = context.BitfieldExtractU32(srcC, bitOffset, Const(8));
+                Operand picked = context.ConditionalSelect(context.ICompareNotEqual(context.BitwiseAnd(nibble, Const(4)), Const(0)), fromC, fromA);
+                Operand replicated = context.BitwiseAnd(context.INegate(context.ShiftRightU32(picked, Const(7))), Const(0xff));
+                Operand value = context.ConditionalSelect(context.ICompareNotEqual(context.BitwiseAnd(nibble, Const(8)), Const(0)), replicated, picked);
+                Operand placed = i == 0 ? value : context.ShiftLeft(value, Const(8 * i));
+
+                result = i == 0 ? placed : context.BitwiseOr(result, placed);
+            }
+
+            context.Copy(GetDest(rd), result);
         }
 
